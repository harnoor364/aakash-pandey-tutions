# Required for the AI Test Paper Analyzer to give real (non-demo) results.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Password to access the /admin leads dashboard.
ADMIN_PASSWORD=change-me

# Optional: forward every new lead to an external webhook (Zapier, Make,
# Slack incoming webhook, Google Sheets webhook, etc). Recommended on
# serverless hosting (e.g. Vercel) where local file storage is not persistent.
LEADS_WEBHOOK_URL=
